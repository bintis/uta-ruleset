<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>osu.Game.Rulesets.Uta.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputType>WinExe</OutputType>
    <StartupObject>osu.Game.Rulesets.Uta.Tests.VisualTestRunner</StartupObject>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(OsuNixDir)' != ''">
    <Reference Include="$(OsuNixDir)/*.dll">
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="NUnit" Version="4.5.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\osu.Game.Rulesets.Uta\osu.Game.Rulesets.Uta.csproj" />
    <Compile Include="UtaCoreTests.cs" />
    <Compile Include="UtaScoringV2Tests.cs" />
    <Compile Include="UtaPerformanceArchiveTests.cs" />
    <Compile Include="UtaRecordingAndFollowUpTests.cs" />
    <Compile Include="UtaGameplayScoringIntegrationTests.cs" />
    <Compile Include="UtaHotPathRegressionTests.cs" />
    <Compile Include="UtaRuntimeHardeningTests.cs" />
    <Compile Include="UtaReleaseRegressionTests.cs" />
    <Compile Include="UtaQueueReservationTests.cs" />
    <Compile Include="VisualTestRunner.cs" />
    <Compile Include="UtaPlayerTestScene.cs" />
    <Compile Include="TestSceneUtaPlayer.cs" />
    <Compile Include="TestSceneUtaOriginalVocals.cs" />
    <Compile Include="TestSceneUtaPresentBeatmap.cs" />
  </ItemGroup>

  <Target Name="CopyOsuNativeAudio" AfterTargets="Build" Condition="'$(OsuNixDir)' != ''">
    <ItemGroup>
      <OsuNativeAudio Include="$(OsuNixDir)/libbass.so" />
      <OsuNativeAudio Include="$(OsuNixDir)/libbassmix.so" />
      <OsuNativeAudio Include="$(OsuNixDir)/libbass_fx.so" />
    </ItemGroup>
    <Copy SourceFiles="@(OsuNativeAudio)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>
</Project>
