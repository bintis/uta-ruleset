<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyTitle>osu.Game.Rulesets.Uta</AssemblyTitle>
    <RootNamespace>osu.Game.Rulesets.Uta</RootNamespace>
    <Version>0.8.2</Version>
    <OutputType>Library</OutputType>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup Condition="'$(OsuNixDir)' != ''">
    <Reference Include="$(OsuNixDir)/*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(OsuNixDir)' == ''">
    <PackageReference Include="ppy.osu.Game" Version="2026.730.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="osu.Game.Rulesets.Uta.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="native\linux-x64\libbassflac.so" CopyToOutputDirectory="PreserveNewest" TargetPath="libbassflac.so" />
    <None Update="native\BASSFLAC.txt" CopyToOutputDirectory="PreserveNewest" TargetPath="BASSFLAC.txt" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="UtaRuleset.cs" />
    <Compile Include="Configuration\**\*.cs" />
    <Compile Include="Core\**\*.cs" />
    <Compile Include="Formats\*.cs" />
    <Compile Include="Localisation\*.cs" />
    <Compile Include="Import\**\*.cs" />
    <Compile Include="Gameplay\**\*.cs" />
    <Compile Include="Global\**\*.cs" />
    <Compile Include="Library\**\*.cs" />
    <Compile Include="Playback\**\*.cs" />
    <Compile Include="Queue\**\*.cs" />
    <Compile Include="Remote\**\*.cs" />
    <Compile Include="Storage\**\*.cs" />
    <Compile Include="Mods\*.cs" />
    <Compile Include="Pitch\*.cs" />
    <Compile Include="Scoring\**\*.cs" />
    <Compile Include="Recording\**\*.cs" />
    <Compile Include="Performance\**\*.cs" />
    <Compile Include="Skinning\**\*.cs" />
    <Compile Include="UI\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Remote\Assets\uta-remote.html" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
</Project>
