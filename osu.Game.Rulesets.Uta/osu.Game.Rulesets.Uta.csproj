<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyTitle>osu.Game.Rulesets.Uta</AssemblyTitle>
    <RootNamespace>osu.Game.Rulesets.Uta</RootNamespace>
    <Version>0.2.0</Version>
    <OutputType>Library</OutputType>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ppy.osu.Game" Version="2026.730.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="UtaRuleset.cs" />
    <Compile Include="Core\**\*.cs" />
    <Compile Include="Formats\*.cs" />
    <Compile Include="Pitch\*.cs" />
    <Compile Include="UI\*.cs" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
</Project>
